#include <Arduino.h>
#include <ESP32Servo.h>
#include <AccelStepper.h>

// ==================== Configuration ====================
namespace hw {
    constexpr uint8_t PWM_PIN         = 13;  // MG90S servo signal
    constexpr uint8_t STEP_PIN        = 25;  // TB6600 PUL-
    constexpr uint8_t DIR_PIN         = 26;  // TB6600 DIR-
    constexpr uint8_t EN_PIN          = 27;  // TB6600 EN-
    constexpr uint8_t ENDSTOP_PIN     = 33;  // NC switch → GND

    constexpr unsigned long DEBOUNCE_US = 1000000UL;  // 1 second
}

// ==================== Protocol Definitions ====================
union FloatBytes {
    float f;
    uint8_t b[4];
};

enum class ParamID : uint8_t {
    RISE_TIME_MS       = 0x01,
    FALL_TIME_MS       = 0x02,
    HOLD_HIGH_MS       = 0x03,
    HOLD_LOW_MS        = 0x04,
    MIN_ANGLE_DEG      = 0x05,
    MAX_ANGLE_DEG      = 0x06,
    STEPS_PER_SEC      = 0x07,
    SERVO_PWM_MIN_US   = 0x08,
    SERVO_PWM_MAX_US   = 0x09,
    RUN_YOKE           = 0x10,
    RUN_CONVEYOR       = 0x11
};

static constexpr uint8_t SYNC_BYTE = 0xAA;
static constexpr uint8_t CMD_SET    = 0x01;
static constexpr uint8_t CMD_TOGGLE = 0x02;
static constexpr uint8_t CMD_GET    = 0x03;
static constexpr uint8_t CMD_ACK    = 0x81;

// ==================== Servo (Yoke) Controller ====================
class YokeController {
public:
    YokeController(uint8_t pwmPin)
      : _pwmPin(pwmPin) {}

    void begin(int minUs, int maxUs, float minDeg, float maxDeg) {
        _minUs = minUs;
        _maxUs = maxUs;
        _minDeg = minDeg;
        _maxDeg = maxDeg;
        attach();
        writeAngle(_minDeg);
        _state = State::Idle;
    }

    void setInverted(bool inv) { _inverted = inv; }
    void setLimits(float minDeg, float maxDeg) {
        _minDeg = constrain(minDeg, 0.0f, 180.0f);
        _maxDeg = constrain(maxDeg, 0.0f, 180.0f);
        writeAngle(_inverted ? _maxDeg : _minDeg);
    }
    void setSweepTimes(float rise, float fall, float stayHigh, float stayLow) {
        _riseMs    = rise;
        _fallMs    = fall;
        _stayHigh  = stayHigh;
        _stayLow   = stayLow;
    }

    void setServoPwmRange(int minUs, int maxUs) {
        _minUs = constrain(minUs, 100, 3000);
        _maxUs = constrain(maxUs, 100, 3000);
        attach();
    }

    void start() {
        if (!_running) {
            _running = true;
            _state = State::Idle;
        }
    }

    void stop() {
        _running = false;
        detach();
    }

    bool isRunning() const { return _running; }

    void update() {
        if (!_running) { _state = State::Idle; return; }
        unsigned long now = millis();
        switch (_state) {
            case State::Idle:
                _currentDeg = _inverted ? _maxDeg : _minDeg;
                writeAngle(_currentDeg);
                _lastMs = now;
                _stepDelay = (_riseMs) / max(1.0f, _maxDeg - _minDeg);
                _state = State::Rising;
                break;

            case State::Rising:
                if (now - _lastMs >= _stepDelay) {
                    stepAngle(+1, State::High, _maxDeg, _fallMs);
                }
                break;

            case State::High:
                if (now - _lastMs >= _stayHigh) {
                    _lastMs = now;
                    _stepDelay = (_fallMs) / max(1.0f, _maxDeg - _minDeg);
                    _state = State::Falling;
                }
                break;

            case State::Falling:
                if (now - _lastMs >= _stepDelay) {
                    stepAngle(-1, State::Low, _minDeg, _riseMs);
                }
                break;

            case State::Low:
                if (now - _lastMs >= _stayLow) {
                    _lastMs = now;
                    _stepDelay = (_riseMs) / max(1.0f, _maxDeg - _minDeg);
                    _state = State::Rising;
                }
                break;
        }
    }

private:
    enum class State { Idle, Rising, High, Falling, Low };
    void attach() { _servo.attach(_pwmPin, _minUs, _maxUs); }
    void detach() { _servo.detach(); }
    void writeAngle(float deg) {
        int logical = lroundf(deg);
        _servo.write(_inverted ? 180 - logical : logical);
    }
    void stepAngle(int delta, State nextState, float bound, float altTime) {
        _lastMs = millis();
        _currentDeg += (_inverted ? -delta : delta);
        if ((!_inverted && _currentDeg >= bound) || (_inverted && _currentDeg <= bound)) {
            _currentDeg = bound;
            writeAngle(_currentDeg);
            _state = nextState;
            _lastMs = millis();
        } else {
            writeAngle(_currentDeg);
        }
    }

    Servo         _servo;
    uint8_t       _pwmPin;
    int           _minUs, _maxUs;
    float         _minDeg, _maxDeg;
    float         _riseMs, _fallMs, _stayHigh, _stayLow;
    unsigned long _stepDelay;
    unsigned long _lastMs;
    float         _currentDeg;
    State         _state;
    bool          _running = false;
    bool          _inverted = false;
};

// ==================== Conveyor (Stepper) Controller ====================
class ConveyorController {
public:
    ConveyorController(uint8_t stepPin, uint8_t dirPin, uint8_t enPin)
      : _stepper(AccelStepper::DRIVER, stepPin, dirPin), _enPin(enPin) {}

    void begin(float speedStepsPerSec) {
        pinMode(_enPin, OUTPUT);
        _stepper.setPinsInverted(true, true, false);
        _stepper.setEnablePin(_enPin);
        _stepper.setMinPulseWidth(20);
        _stepper.enableOutputs();
        setSpeed(speedStepsPerSec);
    }

    void setSpeed(float sps) {
        float sp = max(1.0f, sps);
        _stepper.setMaxSpeed(sp);
        _stepper.setSpeed(sp);
    }

    void start() {
        digitalWrite(_enPin, LOW);
        _running = true;
    }
    void stop() {
        digitalWrite(_enPin, HIGH);
        _running = false;
    }
    bool isRunning() const { return _running; }

    void run() { if (_running) _stepper.runSpeed(); }

private:
    AccelStepper _stepper;
    uint8_t      _enPin;
    bool         _running = false;
};

// ==================== Endstop Debouncer ====================
class Endstop {
public:
    Endstop(uint8_t pin) : _pin(pin) {}
    void begin() {
        pinMode(_pin, INPUT_PULLUP);
        attachInterrupt(digitalPinToInterrupt(_pin), isr, RISING);
    }
    bool hasEvent() {
        noInterrupts();
        bool evt = _flag;
        _flag = false;
        interrupts();
        return evt;
    }

private:
    uint8_t          _pin;
    static volatile bool    _flag;
    static volatile unsigned long lastMicros;
    static void IRAM_ATTR isr() {
        unsigned long now = micros();
        if (now - lastMicros >= hw::DEBOUNCE_US) {
            lastMicros = now;
            _flag = true;
        }
    }
};

// Definition of static members
volatile bool Endstop::_flag = false;
volatile unsigned long Endstop::lastMicros = 0;

// ==================== Protocol Parser ====================
class ProtocolParser {
public:
    ProtocolParser(YokeController& yoke, ConveyorController& conv)
      : _yoke(yoke), _conv(conv), _state(State::WaitSync), _idx(0), _crc(0) {}

    void begin() {
        Serial.begin(115200);
        sendAck(0xFF, 0.0f);
    }

    void process() {
        while (Serial.available()) {
            uint8_t byteIn = Serial.read();
            switch (_state) {
                case State::WaitSync:
                    if (byteIn == SYNC_BYTE) { _state = State::ReadHdr; _idx = 0; _crc = 0; }
                    break;
                case State::ReadHdr:
                    handleHdr(byteIn);
                    break;
                case State::ReadData:
                    _frame.data.b[_idx++] = byteIn;
                    _crc ^= byteIn;
                    if (_idx == 4) _state = State::ReadCrc;
                    break;
                case State::ReadCrc:
                    if (_crc == byteIn) applyFrame();
                    _state = State::WaitSync;
                    break;
            }
        }
    }

    // Public getters for initial configuration
    float getParam(ParamID id) const {
        switch (id) {
            case ParamID::RISE_TIME_MS:     return _riseTime;
            case ParamID::FALL_TIME_MS:     return _fallTime;
            case ParamID::HOLD_HIGH_MS:     return _stayHigh;
            case ParamID::HOLD_LOW_MS:      return _stayLow;
            case ParamID::MIN_ANGLE_DEG:    return _minAngle;
            case ParamID::MAX_ANGLE_DEG:    return _maxAngle;
            case ParamID::STEPS_PER_SEC:    return _stepRate;
            case ParamID::SERVO_PWM_MIN_US: return float(_servoMinUs);
            case ParamID::SERVO_PWM_MAX_US: return float(_servoMaxUs);
            case ParamID::RUN_YOKE:         return _yoke.isRunning() ? 1.0f : 0.0f;
            case ParamID::RUN_CONVEYOR:     return _conv.isRunning() ? 1.0f : 0.0f;
        }
        return 0.0f;
    }

private:
    enum class State { WaitSync, ReadHdr, ReadData, ReadCrc };
    void handleHdr(uint8_t b) {
        if (_idx == 0) _frame.cmd = b;
        else           _frame.id  = b;
        _crc ^= b;
        if (++_idx == 2) { _state = State::ReadData; _idx = 0; }
    }

    void applyFrame() {
        ParamID id = static_cast<ParamID>(_frame.id);
        float v = _frame.data.f;
        switch (_frame.cmd) {
            case CMD_SET:
            case CMD_TOGGLE:
                applyParam(id, v);
                sendAck(_frame.id, getParam(id));
                break;
            case CMD_GET:
                sendAck(_frame.id, getParam(id));
                break;
        }
    }

    void applyParam(ParamID id, float v) {
        switch (id) {
            case ParamID::RISE_TIME_MS:
                _riseTime = v;
                _yoke.setSweepTimes(_riseTime, _fallTime, _stayHigh, _stayLow);
                break;
            case ParamID::FALL_TIME_MS:
                _fallTime = v;
                _yoke.setSweepTimes(_riseTime, _fallTime, _stayHigh, _stayLow);
                break;
            case ParamID::HOLD_HIGH_MS:
                _stayHigh = v;
                _yoke.setSweepTimes(_riseTime, _fallTime, _stayHigh, _stayLow);
                break;
            case ParamID::HOLD_LOW_MS:
                _stayLow = v;
                _yoke.setSweepTimes(_riseTime, _fallTime, _stayHigh, _stayLow);
                break;
            case ParamID::MIN_ANGLE_DEG:
                _minAngle = constrain(v, 0.0f, 180.0f);
                _yoke.setLimits(_minAngle, _
